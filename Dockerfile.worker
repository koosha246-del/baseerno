# =================================================================
# Dedicated email-worker image.
#
# The main Dockerfile's runner stage only ships `.next/standalone`,
# which does NOT include tsx or the worker source — so the worker needs
# its own image that keeps the full node_modules + src/ tree.
# =================================================================

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install full deps (including dev deps — tsx is a devDependency).
# (prisma.config.ts is required by Prisma 7 CLI commands)
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma/
RUN npm ci

# Generate Prisma client
RUN npx prisma generate

# Copy the whole source tree (worker + lib).
COPY . .

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# The worker runs the outbox poller as a long-lived process.
# Exec form + direct tsx binary: `npx` would be PID 1 and does not reliably
# forward SIGTERM to the worker, so in-flight email batches would be killed
# mid-send instead of draining gracefully.
CMD ["node_modules/.bin/tsx", "worker/email-worker.ts"]
