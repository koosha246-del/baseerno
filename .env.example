# ─── Core ─────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/baseerno
# Optional direct (non-pooled) URL for migrations when DATABASE_URL is pooled:
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/baseerno
# Optional read-replica (heavy dashboard/report reads):
# REPLICA_URL=postgresql://postgres:postgres@localhost:5432/baseerno_replica

# ─── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-32chars
# During key rotation, set the previous secret so old tokens stay valid:
# JWT_SECRET_OLD=

# ─── Payments ──────────────────────────────────────────────────────
PAYMENT_SIGNATURE_SECRET=change-me-payment-secret
# During rotation:
# PAYMENT_SIGNATURE_SECRET_OLD=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# ─── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
# Sender shown to recipients. Must belong to a VERIFIED Resend domain
# (SPF/DKIM). Default: "بصیر نو <noreply@baseerno.ir>"
# EMAIL_FROM="بصیر نو <no-reply@baseerno.ir>"

# ─── Cron protection (Vercel Cron / external scheduler) ────────────
# Required for /api/cron/* — sent as `Authorization: Bearer <CRON_SECRET>`
# or `x-cron-secret: <CRON_SECRET>`. Fail-closed when unset.
CRON_SECRET=

# ─── AI tutor (optional — without key the chat returns mock replies) ─
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ─── Cloudinary ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Redis (optional — falls back to in-memory rate limiting / cache) ─
REDIS_URL=

# ─── Dedicated search (Meilisearch — optional, falls back to Postgres FTS) ──
# Start it locally:  docker compose up -d meilisearch
# Then run the seed:  npm run seed:search   (indexes all published courses)
# Verify everything:  npm run verify:search
SEARCH_HOST=http://localhost:7700
SEARCH_API_KEY=baseerno-dev-master-key

# ─── Observability ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_GA_ID=

# ─── Public site ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=بصیر نو

# ─── Demo mode (dev only) ─────────────────────────────────────
# No-DB mode: login works with demo accounts (password 123456).
# Never enable in production.
DEMO_MODE=false
