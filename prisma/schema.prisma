// =================================================================
// بصیر نو (Baseer No) — Prisma schema
// =================================================================
// Migration history: see prisma/migrations/
// Soft delete: every model carries `deletedAt DateTime?`. The repository
// layer (src/lib/db/prisma-client.ts) installs a `$extends` client that
// transparently filters `deletedAt: null` on every find* call, so the
//   vast majority of application code can stay unchanged. To fetch
//   soft-deleted rows, use the `_raw` client (`prismaRaw`) explicitly.
// updatedAt: Prisma auto-stamps `updatedAt` on every record change.
// =================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(STUDENT)
  avatar       String?
  phone        String?
  bio          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  mentorCourses    Course[]        @relation("MentorCourses")
  enrollments      Enrollment[]
  grades           Grade[]         @relation("StudentGrades")
  taughtGrades     Grade[]         @relation("TeacherGrades")
  certificates     Certificate[]
  payments         Payment[]
  sentMessages     Message[]       @relation("SentMessages")
  receivedMessages Message[]       @relation("ReceivedMessages")
  passwordResets   PasswordReset[]
  notifications    Notification[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
}

model Course {
  id            String   @id @default(cuid())
  title         String
  subtitle      String
  description   String   @db.Text
  mentorId      String
  price         Int?
  originalPrice Int?
  level         String   @default("مقدماتی")
  category      String
  durationHours Int
  lessons       Int
  rating        Float    @default(0)
  glyph         String
  accent        String
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  mentor       User         @relation("MentorCourses", fields: [mentorId], references: [id])
  enrollments  Enrollment[]
  grades       Grade[]
  certificates Certificate[]
  payments     Payment[]
  lessonItems  Lesson[]

  @@index([mentorId])
  @@index([published])
  @@index([category])
  @@index([deletedAt])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  progress    Int              @default(0)
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  user        User         @relation(fields: [userId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  grades      Grade[]
  certificate Certificate?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([deletedAt])
}

model Grade {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  enrollmentId String
  score        Float
  feedback     String?
  gradedAt     DateTime @default(now())
  teacherId    String
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  user       User       @relation("StudentGrades", fields: [userId], references: [id])
  course     Course     @relation(fields: [courseId], references: [id])
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  teacher    User       @relation("TeacherGrades", fields: [teacherId], references: [id])

  @@index([userId])
  @@index([teacherId])
  @@index([enrollmentId])
  @@index([deletedAt])
}

model Certificate {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  enrollmentId      String   @unique
  certificateNumber String   @unique
  issueDate         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  user       User       @relation(fields: [userId], references: [id])
  course     Course     @relation(fields: [courseId], references: [id])
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@index([userId])
  @@index([deletedAt])
}

model Payment {
  id               String        @id @default(cuid())
  userId           String
  courseId         String
  amount           Int
  status           PaymentStatus @default(PENDING)
  method           String
  /// Zarinpal Authority (or other gateway reference) for callback correlation
  gatewayAuthority String?       @unique
  /// Gateway ref id after successful verify (e.g. Zarinpal ref_id)
  gatewayRefId     String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([deletedAt])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  body       String   @db.Text
  read       Boolean  @default(false)
  sentAt     DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([deletedAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
  @@index([deletedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("info")
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@index([deletedAt])
}

model Lesson {
  id              String   @id @default(cuid())
  courseId        String
  title           String
  type            String   @default("video")
  videoUrl        String?
  durationMinutes Int
  sortOrder       Int      @default(0)
  isFree          Boolean  @default(false)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([sortOrder])
  @@index([deletedAt])
}
