// =================================================================
// بصیر نو (Baseer No) — Prisma schema
// =================================================================
// Migration history: see prisma/migrations/
// Soft delete: every model carries `deletedAt DateTime?`. The repository
// layer (src/lib/db/prisma-client.ts) installs a `$extends` client that
// transparently filters `deletedAt: null` on every find* call, so the
//   vast majority of application code can stay unchanged. To fetch
//   soft-deleted rows, use the `_raw` client (`prismaRaw`) explicitly.
// updatedAt: Prisma auto-stamps `updatedAt` on every record change.
// =================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(STUDENT)
  avatar       String?
  phone        String?
  bio          String?
  /// TOTP base32 secret — set when the user enables 2FA.
  twoFactorSecret String?
  /// Whether 2FA is active for this user (enforced on login).
  twoFactorEnabled Boolean @default(false)
  /// Bumped on password change/reset so existing JWTs are invalidated
  /// (each token carries the version it was issued at).
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  mentorCourses    Course[]        @relation("MentorCourses")
  enrollments      Enrollment[]
  grades           Grade[]         @relation("StudentGrades")
  taughtGrades     Grade[]         @relation("TeacherGrades")
  certificates     Certificate[]
  payments         Payment[]
  sentMessages     Message[]       @relation("SentMessages")
  receivedMessages Message[]       @relation("ReceivedMessages")
  passwordResets   PasswordReset[]
  notifications    Notification[]
  aiConversations  Conversation[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
}

/// AI tutor — a conversation thread between a student and the assistant,
/// optionally scoped to a course so the assistant knows the context.
model Conversation {
  id        String   @id @default(cuid())
  userId    String
  courseId  String?
  title     String   @default("گفتگو با دستیار")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user     User          @relation(fields: [userId], references: [id])
  course   Course?       @relation(fields: [courseId], references: [id])
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@index([courseId])
  @@index([deletedAt])
}

/// A single turn inside an AI conversation.  `role` is "user" | "assistant".
model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" | "assistant"
  content        String   @db.Text
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@index([deletedAt])
}

model Course {
  id            String   @id @default(cuid())
  title         String
  subtitle      String
  description   String   @db.Text
  mentorId      String
  price         Int?
  originalPrice Int?
  level         String   @default("مقدماتی")
  category      String
  durationHours Int
  lessons       Int
  rating        Float    @default(0)
  glyph         String
  accent        String
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  mentor       User         @relation("MentorCourses", fields: [mentorId], references: [id])
  enrollments  Enrollment[]
  grades       Grade[]
  certificates Certificate[]
  payments     Payment[]
  lessonItems  Lesson[]
  aiConversations Conversation[]

  @@index([mentorId])
  @@index([published])
  @@index([published, createdAt])
  @@index([mentorId, published])
  @@index([category])
  @@index([deletedAt])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  progress    Int              @default(0)
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  user        User         @relation(fields: [userId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  grades      Grade[]
  certificate Certificate?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([userId, enrolledAt])
  @@index([courseId])
  @@index([deletedAt])
}

model Grade {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  enrollmentId String
  score        Float
  feedback     String?
  gradedAt     DateTime @default(now())
  teacherId    String
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  user       User       @relation("StudentGrades", fields: [userId], references: [id])
  course     Course     @relation(fields: [courseId], references: [id])
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  teacher    User       @relation("TeacherGrades", fields: [teacherId], references: [id])

  @@index([userId])
  @@index([userId, gradedAt])
  @@index([teacherId])
  @@index([teacherId, gradedAt])
  @@index([enrollmentId])
  @@index([deletedAt])
}

model Certificate {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  enrollmentId      String   @unique
  certificateNumber String   @unique
  issueDate         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  user       User       @relation(fields: [userId], references: [id])
  course     Course     @relation(fields: [courseId], references: [id])
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@index([userId])
  @@index([deletedAt])
}

model Payment {
  id               String        @id @default(cuid())
  userId           String
  courseId         String
  amount           Int
  status           PaymentStatus @default(PENDING)
  method           String
  /// Zarinpal Authority (or other gateway reference) for callback correlation
  gatewayAuthority String?       @unique
  /// Gateway ref id after successful verify (e.g. Zarinpal ref_id)
  gatewayRefId     String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([deletedAt])
  // NOTE: a PARTIAL unique index also exists in SQL (one PENDING order per
  // user+course — see migration 20260829000000). Prisma cannot express
  // partial indexes in the schema; do not remove it via `migrate dev`.
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  body       String   @db.Text
  read       Boolean  @default(false)
  sentAt     DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([senderId, sentAt])
  @@index([receiverId])
  @@index([receiverId, sentAt])
  @@index([deletedAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
  @@index([deletedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("info")
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt])
  @@index([deletedAt])
}

model Lesson {
  id              String   @id @default(cuid())
  courseId        String
  title           String
  type            String   @default("video")
  videoUrl        String?
  durationMinutes Int
  sortOrder       Int      @default(0)
  isFree          Boolean  @default(false)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([sortOrder])
  @@index([deletedAt])
}

model EmailOutbox {
  id        String   @id @default(cuid())
  to        String
  subject   String
  html      String
  status    String   @default("pending") // pending | sent | failed
  retries   Int      @default(0)
  maxRetries Int     @default(3)
  lastError String?
  /// Next attempt timestamp for exponential backoff.
  nextAttemptAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sentAt    DateTime? @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
}

/// Generated column + GIN index for full-text search across courses.
/// The actual tsvector column and GIN index are created via a raw
/// migration (see prisma/migrations/...add_fts_index).  Prisma does
/// not natively support tsvector, so the `searchVector` column and
/// its index are managed by hand as `Unsupported`.
model CourseSearch {
  id         String                                @id
  title      String
  subtitle   String
  /// Actual PostgreSQL tsvector column — created via raw SQL.
  searchVector Unsupported("tsvector")?

  @@index([searchVector], name: "course_search_gin_idx", type: Gin)
}

/// One k6 load-test run — recorded by scripts/load/record-run.ts after
/// each test so the Ops dashboard can chart p95 / error trends over time.
/// `scenarios` holds the per-scenario stats from the k6 result:
///   { browse: {p50,p95,p99,avg,errors}, search: {...}, dashboard: {...} }
model LoadRun {
  id              String   @id @default(cuid())
  baseUrl         String
  vus             Int
  durationSeconds Int
  pass            Boolean
  scenarios       Json
  cacheHits       Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

/// Security audit trail — every sensitive action is recorded here via
/// the event bus (login, password change, cert issue, payment failure,
/// admin moderation). Never stores passwords/tokens/secrets.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}
